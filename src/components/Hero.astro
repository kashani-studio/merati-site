---
import settings from "../content/settings.json";
import SocialLinks from "./SocialLinks.astro";
import { imageAsset } from "../lib/images";
const h = settings.hero;
const heroImage = imageAsset("/uploads/hero-tilework.png").src;

type Stat = { value: string; label: string };
const stats: Stat[] = h.stats;
const parseStat = (value: string) => {
  const m = value.match(/^(\d+)(\D*)$/);
  return m ? { num: m[1], suffix: m[2] } : null;
};
---
<section class="hero" data-hero>
  <div
    class="hero-canvas"
    data-hero-canvas
    data-hero-src={heroImage}
    style={`--hero-img: url('${heroImage}')`}
    aria-hidden="true"
  ></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div data-hero-stagger>
      <SocialLinks variant="hero" label="Volg ons online" />
    </div>

    <h1 class="hero-title display" data-hero-title>
      {h.titleLine1} <em>{h.titleEmphasis}</em>
    </h1>
    <p class="hero-lead" data-hero-stagger>{h.lead}</p>

    <div class="hero-actions" data-hero-stagger>
      <a href="/#contact" class="btn btn-primary btn-lg" data-magnetic="0.4" data-cursor="Offerte">
        Vraag uw offerte aan
      </a>
      <a href="/realisaties" class="btn btn-ghost btn-lg" data-magnetic="0.4">
        Bekijk realisaties
      </a>
      <a href={`tel:${settings.contact.phone.replace(/\s+/g, "")}`} class="hero-phone" aria-label={`Bel Merati rechtstreeks op ${settings.contact.phoneDisplay}`}>
        <span class="hero-phone-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.34 1.83.58 2.79.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </span>
        <span class="hero-phone-copy">
          <span class="hero-phone-label">Bel rechtstreeks</span>
          <span class="hero-phone-number">{settings.contact.phoneDisplay}</span>
        </span>
      </a>
    </div>

    <div class="hero-stats" data-hero-stagger aria-label="Onze cijfers">
      {stats.map((s) => {
        const p = parseStat(s.value);
        return (
          <div class="hero-stat">
            {p ? (
              <strong data-count={p.num} data-count-suffix={p.suffix}>0{p.suffix}</strong>
            ) : (
              <strong>{s.value}</strong>
            )}
            <span>{s.label}</span>
          </div>
        );
      })}
    </div>
  </div>

  <span class="hero-cue" data-hero-cue>Scroll</span>
</section>
