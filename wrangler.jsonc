{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merati-site",
  "compatibility_date": "2026-05-08",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "d1_databases": [
    {
      "binding": "VISITS",
      "database_name": "merati-visits",
      "database_id": "5f60f4e3-683e-49a0-9c19-96f19b836d29",
      "migrations_dir": "migrations/visits"
    }
  ]
}
